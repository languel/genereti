        "// A luminous abstract performance stage made from hand-cut paper shapes, cobalt blue and orange light, energetic theatrical composition\nlet entries=0;\nfunction setup(){createCanvas(windowWidth,windowHeight);__.events.on(\"person.present\",e=>{if(e.phase===\"entry\")entries++})}\nfunction draw(){const r=__.streams.read(\"body\",500);const coverage=r?.features[\"segment.coverage\"]??0;background(20,25,40);noStroke();fill(35,90,205);rect(25,25,width-50,height-50);fill(235,130,40);circle(width*.5,height*.5,35+coverage*height);fill(245);textSize(16);text(r?\"coverage \"+coverage.toFixed(2):\"waiting for fresh body stream\",40,height-55);text(\"presence entries \"+entries,40,height-30)}",
