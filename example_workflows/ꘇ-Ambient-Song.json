      "widgets_values_named": {
        "guide": "{\n  \"format\": \"genereti-guide\",\n  \"version\": 1,\n  \"id\": \"ambient-song\",\n  \"title\": \"Ambient: a slow constellation\",\n  \"summary\": \"A model-free song patch with an interactive walkthrough; sound starts only when you choose.\",\n  \"steps\": [\n    {\n      \"title\": \"Start listening\",\n      \"text\": \"Press Start on the output to enable sound, then play the transport if it is paused. Start with a low system volume. The scope is the only visual: it shows the actual sound.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioOutput\",\n        \"ref\": \"6040952c-3bd3-5a4f-9323-3e27e3358908\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"Audio requires your own Start gesture; loading or queueing this workflow does not start sound.\"\n    },\n    {\n      \"title\": \"Set the pulse\",\n      \"text\": \"The project clock drives all three parts. Try a small change in tempo or swing and listen to the relationship between the parts.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioTransport\",\n        \"ref\": \"b519147e-44c2-55f8-b5ce-8f72a31ffbb2\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"The timeline and this transport share the project clock.\"\n    },\n    {\n      \"title\": \"Edit the melody\",\n      \"text\": \"Click a piano-roll cell to place or remove a note; drag to draw a phrase. Listen to the spaces between notes.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioSequence\",\n        \"ref\": \"e735cd5f-423e-5400-83c6-681e8f914b07\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"Use the octave and transpose controls to find another register.\"\n    },\n    {\n      \"title\": \"Shape the low part\",\n      \"text\": \"Change the bass notes, then adjust the low voice filter and envelope. Solo its mixer channel to hear it on its own.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioSynth\",\n        \"ref\": \"156cf36c-9d89-5e7d-a2a4-96c80cd98560\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"A longer release overlaps notes; a lower cutoff softens the sound.\"\n    },\n    {\n      \"title\": \"Make the rhythm your own\",\n      \"text\": \"Draw hits in the drum grid. Shift-click makes an accent and Alt-click makes a ghost hit. Mute or solo the drum channel to compare the arrangement.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioDrumSequence\",\n        \"ref\": \"45081f99-72c3-5f42-bee7-4c01d42000b8\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"The sparse percussion is optional; mute it for a beatless version.\"\n    },\n    {\n      \"title\": \"Create space\",\n      \"text\": \"Adjust the delay mix and feedback, then the reverb mix. Bring the melody channel down if the echoes cover the bass or drums.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioReverb\",\n        \"ref\": \"141c8555-147b-50b3-a4ec-0bfcd700d95a\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"The effects process only the melody; the bass and drums remain clear.\"\n    },\n    {\n      \"title\": \"Perform and finish\",\n      \"text\": \"Use the mixer mute and solo buttons to bring parts in and out. Press Stop on the output when finished; record with the output record button if you want to keep a take.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioMixer\",\n        \"ref\": \"7c25cff5-e54a-5a0a-9e84-d64672dd3eb7\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"Try an introduction with only the melody, then add bass and rhythm one at a time.\"\n    }\n  ]\n}",
        "genereti_delivery": "Live"
      }
    }
