# Registry allowlist. Keep aligned with distribution/manifest.json and its test.
/*
!/__init__.py
!/pyproject.toml
!/requirements.txt
!/.comfyignore
!/README.md
!/LICENSE
!/package.json
!/package-lock.json
!/distribution/
/distribution/*
!/distribution/manifest.json
!/scripts/
/scripts/*
!/scripts/install_comfy_workflows.py
!/scripts/comfy_agent_cli.py
!/scripts/build_comfy_package.py
!/scripts/build_editor.mjs
!/scripts/build_livecode.mjs
!/scripts/build_performance.mjs
!/scripts/build_livecode_lessons.py
!/docs/
!/editor/
!/web/
/web/*
!/web/vendor/
/web/vendor/*
!/web/vendor/excalidraw/
!/integrations/
/integrations/*
!/integrations/genereti_comfy_inputs/
!/integrations/genereti_comfy_p5/
!/integrations/genereti_comfy_drawing/
!/integrations/genereti_comfy_stream/
!/integrations/genereti_comfy_texture/
!/integrations/genereti_comfy_chop/
!/integrations/genereti_comfy_dat/
!/integrations/genereti_comfy_projector/
!/integrations/genereti_comfy_performance/
!/integrations/genereti_comfy_agent/
!/integrations/comfyui_genereti/
/integrations/comfyui_genereti/*
!/integrations/comfyui_genereti/workflows/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/*.mlpackage/
**/*.mlmodelc/
**/*.safetensors
**/*.ckpt
**/*.pt
**/*.pth
**/*.bin
**/*.task
**/*.wav
**/*.mp4
**/*.mov
**/*.webm
**/*.log
