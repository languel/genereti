        "generetiLivecodeLastGood": {
          "mode": "p5",
          "source": "// Transparent source: one renderer feeds every output.\nfunction setup(){createCanvas(windowWidth,windowHeight)}\nfunction draw(){\n clear();noStroke();\n for(let i=0;i<3;i++){\n  const t=frameCount*.025+i*TWO_PI/3;\n  fill(i===0?230:90,i===1?155:105,i===2?225:110,230);\n  circle(width/2+cos(t)*width*.27,\n         height/2+sin(t*1.3)*height*.25,42+i*12);\n }\n if(mouseIsPressed){fill(235);circle(mouseX,mouseY,45)}\n}"
        }
      },
