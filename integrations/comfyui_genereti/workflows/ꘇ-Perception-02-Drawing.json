        "p5",
        640,
        360,
        true,
        "// Sample stage: a blue rectangle and orange triangle; a body-driven cursor draws over it.\n// Select another landmark in perception.features: its first selected point drives pointer.x/y.\nlet previous=null, revision='', lastFrame=-1, armed=false?false:true, hue=30;\nfunction setup(){createCanvas(windowWidth,windowHeight);colorMode(HSB,360,100,100,1);background(225,50,12);noStroke();fill(220,70,55);rect(30,30,width-60,height-60);fill(30,75,85);triangle(width*.5,40,width-60,height*.55,60,height*.55);if(false)__.events.on('brush.down',e=>{armed=e.phase==='entry';if(armed)hue=(hue+75)%360;previous=null})}\nfunction draw(){const r=__.streams.read('selected',500),f=r?.features,x=f?.['pointer.x'],y=f?.['pointer.y'];if(!r||!armed||!Number.isFinite(x)||!Number.isFinite(y)){previous=null;return}const key=JSON.stringify([r.source.id,r.source.output_slot,r.source.revision,r.source.width,r.source.height,r.selection?.names]);if(key!==revision){revision=key;previous=null;lastFrame=-1}if(lastFrame===r.source.frame_timestamp_ms)return;lastFrame=r.source.frame_timestamp_ms;const p={x,y};if(previous&&dist(x,y,previous.x,previous.y)<.3){stroke(hue,75,95,.8);strokeWeight(false?8:3);line(previous.x*width,previous.y*height,x*width,y*height);if(false){noStroke();fill(hue,50,100,.65);circle(x*width,y*height,12)}}previous=p}\nfunction keyPressed(){if(key==='r'||key==='R'){background(225,50,12);previous=null}}\n",
