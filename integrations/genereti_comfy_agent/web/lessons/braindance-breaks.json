      "widgets_values_named": {
        "guide": "{\n  \"format\": \"genereti-guide\",\n  \"version\": 1,\n  \"id\": \"braindance-breaks\",\n  \"title\": \"Braindance: fractured breaks\",\n  \"summary\": \"A model-free song patch with an interactive walkthrough; sound starts only when you choose.\",\n  \"steps\": [\n    {\n      \"title\": \"Start listening\",\n      \"text\": \"Press Start on the output to enable sound, then play the transport if it is paused. Start with a low system volume. The scope is the only visual: it shows the actual sound.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioOutput\",\n        \"ref\": \"668f5982-5557-5811-8130-6a03434ecb2d\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"Audio requires your own Start gesture; loading or queueing this workflow does not start sound.\"\n    },\n    {\n      \"title\": \"Set the pulse\",\n      \"text\": \"The project clock drives all three parts. Try a small change in tempo or swing and listen to the relationship between the parts.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioTransport\",\n        \"ref\": \"3cdb0dce-083d-5c56-aed5-42fd3a60fcff\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"The timeline and this transport share the project clock.\"\n    },\n    {\n      \"title\": \"Edit the melody\",\n      \"text\": \"Click a piano-roll cell to place or remove a note; drag to draw a phrase. Listen to the spaces between notes.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioSequence\",\n        \"ref\": \"c8482f86-af32-5773-b324-b1e9bb204b8e\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"Use the octave and transpose controls to find another register.\"\n    },\n    {\n      \"title\": \"Shape the low part\",\n      \"text\": \"Change the bass notes, then adjust the low voice filter and envelope. Solo its mixer channel to hear it on its own.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioSynth\",\n        \"ref\": \"4f656bf3-cc07-5956-9c36-7e71465dfb3d\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"A longer release overlaps notes; a lower cutoff softens the sound.\"\n    },\n    {\n      \"title\": \"Make the rhythm your own\",\n      \"text\": \"Draw hits in the drum grid. Shift-click makes an accent and Alt-click makes a ghost hit. Mute or solo the drum channel to compare the arrangement.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioDrumSequence\",\n        \"ref\": \"0a260495-0b8e-551a-9c14-3e016d89d64d\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"For a break, add a few quiet snare or rim hits and leave space around the main snare.\"\n    },\n    {\n      \"title\": \"Create space\",\n      \"text\": \"Adjust the delay mix and feedback, then the reverb mix. Bring the melody channel down if the echoes cover the bass or drums.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioReverb\",\n        \"ref\": \"5dfc4740-bbe0-5603-86e9-6e714123086b\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"The effects process only the melody; the bass and drums remain clear.\"\n    },\n    {\n      \"title\": \"Perform and finish\",\n      \"text\": \"Use the mixer mute and solo buttons to bring parts in and out. Press Stop on the output when finished; record with the output record button if you want to keep a take.\",\n      \"target\": {\n        \"nodeType\": \"GeneretiAudioMixer\",\n        \"ref\": \"dd01ea0e-cc50-5c15-ba49-a5098fe0fbaa\",\n        \"part\": \"node\"\n      },\n      \"hint\": \"Try an introduction with only the melody, then add bass and rhythm one at a time.\"\n    }\n  ]\n}",
        "genereti_delivery": "Live"
      }
    }
