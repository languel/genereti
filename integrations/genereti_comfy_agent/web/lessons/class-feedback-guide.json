            "ref": "5c0d6588-d57f-4e81-9e0e-20484c85d035",
            "widget": "value"
          },
          "value": 0.98
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureFilter",
            "ref": "7a5a84db-4026-4aa1-9329-52e63151042d",
            "widget": "operation"
          },
          "value": "level"
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureFilter",
            "ref": "7a5a84db-4026-4aa1-9329-52e63151042d",
            "widget": "amount"
          },
          "value": 0.4
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureComposite",
            "ref": "ba61e572-ddfe-4eb3-a191-dec5acd32c19",
            "widget": "operation"
          },
          "value": "screen"
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureComposite",
            "ref": "ba61e572-ddfe-4eb3-a191-dec5acd32c19",
            "widget": "opacity"
          },
          "value": 1
        }
      ]
    },
    {
      "target": {
        "nodeType": "GeneretiTextureChannels",
        "part": "node",
        "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16"
      },
      "text": "top.channels can extract alpha or luminance, swap RGB, or combine A with B channels such as br/bg/bb/ba. B here is the bloom. RGB uses opaque GPU alpha and returns a three-channel queued IMAGE; RGBA uses the alpha selector. Live texture storage remains RGBA.",
      "title": "Route and combine channels",
      "hint": "A is the composite; B is bloom. Try red=b or green=bg to remix the color. Do it restores r/g/b with opaque alpha and RGB output.",
      "actions": [
        {
          "kind": "connect",
          "source": {
            "nodeType": "GeneretiTextureComposite",
            "ref": "ba61e572-ddfe-4eb3-a191-dec5acd32c19"
          },
          "target": {
            "nodeType": "GeneretiTextureChannels",
            "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16"
          },
          "output": "image",
          "input": "image"
        },
        {
          "kind": "connect",
          "source": {
            "nodeType": "GeneretiTextureBloom",
            "ref": "42c558d1-e964-463f-8a07-6dd051d2cac0"
          },
          "target": {
            "nodeType": "GeneretiTextureChannels",
            "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16"
          },
          "output": "image",
          "input": "image_b"
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureChannels",
            "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16",
            "widget": "red"
          },
          "value": "r"
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureChannels",
            "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16",
            "widget": "green"
          },
          "value": "g"
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureChannels",
            "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16",
            "widget": "blue"
          },
          "value": "b"
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureChannels",
            "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16",
            "widget": "alpha"
          },
          "value": "one"
        },
        {
          "kind": "set-widget",
          "target": {
            "nodeType": "GeneretiTextureChannels",
            "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16",
            "widget": "channels"
          },
          "value": "RGB"
        }
      ]
    },
    {
      "target": {
        "nodeType": "GeneretiLiveImagePreview",
        "part": "node",
        "ref": "397ab396-3a65-48cc-9180-961661b283f3"
      },
      "text": "Alt-W opens the interactive output, Alt-F fills the window. Clear delayed reference frame resets the loop without reconstructing the graph. top.feedback remains the convenient self-contained variant. Audio, camera and screen remain explicitly user-started.",
      "title": "Present and experiment",
      "hint": "Connect the routed channels to the viewer. Do it opens its output overlay; then use Alt-F to fill the window and Escape to restore it.",
      "actions": [
        {
          "kind": "connect",
          "source": {
            "nodeType": "GeneretiTextureChannels",
            "ref": "fa428d88-4bf9-41e8-baef-a1cc2d4ced16"
          },
          "target": {
            "nodeType": "GeneretiLiveImagePreview",
            "ref": "397ab396-3a65-48cc-9180-961661b283f3"
          },
          "output": "image",
          "input": "image"
        },
        {
          "kind": "view",
          "target": {
